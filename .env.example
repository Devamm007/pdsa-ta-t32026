# ─── Google OAuth 2.0 Client ID ───────────────────────────────────────────
# Get this from: Google Cloud Console → APIs & Services → Credentials
# Create "OAuth 2.0 Client ID" with type "Web Application"
# Add authorized origins: http://localhost:8000 (dev) + your production domain
GOOGLE_CLIENT_ID=

# ─── Session Security Secret ─────────────────────────────────────────────
# A strong random secret for HMAC-SHA256 session token signing.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# REQUIRED for production — leave empty for dev (random secret each restart)
SESSION_SECRET=

# ─── Gemini API Key (Optional) ────────────────────────────────────────────
# Used for AI-powered Repo Analysis
GEMINI_API_KEY=

# ─── Environment Flag (Local vs Production) ──────────────────────────────
# Set to "false" for local development (automatically uses local SQLite app.db)
# Set to "true" in production (automatically uses Neon DB PostgreSQL)
PRODUCTION=false

# ─── Neon DB / PostgreSQL Instance ───────────────────────────────────────
# Used when PRODUCTION=true (or when deployed on Render / HuggingFace)
# Neon DB Serverless connection string format:
NEON_DATABASE_URL=postgresql://neondb_owner:<password>@<ep-pooler-id>.us-east-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# ─── Local PostgreSQL Override (Optional) ─────────────────────────────────
# Set to 'true' if you want to test PostgreSQL locally instead of SQLite:
# FORCE_POSTGRES=false

# ─── Server Port (optional) ──────────────────────────────────────────────
# Defaults to 7860 (HuggingFace) or controlled via PORT env var (Render)
# PORT=8000

CRON_SECRET= 